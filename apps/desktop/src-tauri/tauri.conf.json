{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "EfficiencyMemo",
  "version": "0.6.4",
 "identifier": "com.efficiency-memo.app",
 "build": {
 "frontendDist": "../dist",
 "devUrl": "http://localhost:1420",
 "beforeDevCommand": "pnpm dev",
 "beforeBuildCommand": "pnpm build"
 },
  "app": {
  "windows": [
 {
 "title": "EfficiencyMemo",
 "width":1280,
 "height":800,
 "resizable": true,
 "fullscreen": false
 }
 ],
 "security": {
 "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
 }
 },
 "bundle": {
 "active": true,
 "createUpdaterArtifacts": true,
  "targets": ["msi", "nsis", "app", "dmg", "appimage", "deb"],
 "resources": ["resources/*"],
 "icon": [
 "icons/32x32.png",
 "icons/128x128.png",
 "icons/128x128@2x.png",
 "icons/icon.icns",
 "icons/icon.ico"
 ],
 "windows": {
 "webviewInstallMode": {
 "type": "downloadBootstrapper"
 },
 "wix": {
 "language": ["en-US"]
 },
 "nsis": {
 "installMode": "perMachine"
 }
 }
 },
 "plugins": {
 "updater": {
 "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2ODdEM0NENTM2RTY1NkEKUldScVpXNVR6ZE9IbHZLZ2pGN1J5dGxlVHNMbXlrckZMK1d5Mmk4R1A4S0JWcGlsd2MyYTFpY2gK",
 "endpoints": ["https://github.com/HashTagGit/efficiency-memo/releases/latest/download/latest.json"],
 "windows": { "installMode": "passive" }
 },
 "sql": {
 "preload": ["sqlite:efficiency-memo.db"]
 }
 }
}
