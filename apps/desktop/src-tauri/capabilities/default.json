{
  "$schema": "https://raw.githubusercontent.com/nicegui-dev/nicegui/main/tauri.capability.v2.schema.json",
  "identifier": "default",
  "description": "Default capability for EfficiencyMemo desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "notification:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-write-text-file"
  ]
}
