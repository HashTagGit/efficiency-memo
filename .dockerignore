# =============================================================================
# .dockerignore — Exclude paths from the Docker build context.
#
# Mirrors the project's .gitignore plus Docker-specific exclusions so that
# `docker build` ships a small, deterministic context (target: < ~100MB).
#
# Negation rules are honored: a leading `!` re-includes a path that was
# excluded by an earlier pattern. Keep this in mind when reordering entries.
#
# IMPORTANT: bare directory patterns (e.g. `node_modules/`) match at the root
# of the build context only. Workspace packages each have their own
# `node_modules/`, `.next/`, etc., so use `**/node_modules/` to catch them all.
# =============================================================================

# -----------------------------------------------------------------------------
# Build outputs (any depth — `**/` matches across workspace packages)
# -----------------------------------------------------------------------------
**/node_modules/
**/.pnpm-store/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/coverage/
**/test-results/
**/playwright-report/
**/.playwright-mcp/

# -----------------------------------------------------------------------------
# TypeScript / bundler caches (any depth)
# -----------------------------------------------------------------------------
**/*.tsbuildinfo
**/.cache/

# -----------------------------------------------------------------------------
# VCS metadata
# -----------------------------------------------------------------------------
.git/
.gitignore
.gitattributes

# -----------------------------------------------------------------------------
# Environment files
# Whitelist only .env.docker for the runtime container; ship everything else
# via secrets / orchestrator env injection.
# -----------------------------------------------------------------------------
.env*
!.env.docker
.env.docker.local

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# OS / editor junk
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tmp

# -----------------------------------------------------------------------------
# Tool-generated artifacts (not part of the production image)
# -----------------------------------------------------------------------------
.omo/
.omo/drafts/
.planning/
.understand-anything/
.codegraph/
.cache/

# -----------------------------------------------------------------------------
# Supabase CLI runtime state
# -----------------------------------------------------------------------------
supabase/.branches/
supabase/.temp/

# End of .dockerignore
